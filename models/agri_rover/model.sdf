          <diffuse>0.28 0.28 0.30 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
    </link>

    <!-- FRONT RIGHT WHEEL -->
    <link name="front_right_wheel">
      <pose>0.24 -0.25 0.13 -1.5707963 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.007</ixx>
