    <!-- REAR LEFT WHEEL -->
    <link name="rear_left_wheel">
      <pose>-0.24 0.25 0.13 -1.5707963 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.007</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.007</iyy>
          <iyz>0</iyz>
          <izz>0.012</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.13</radius>
