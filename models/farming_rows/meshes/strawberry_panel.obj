# 20cm x 20cm double-sided vertical panel in the Y-Z plane
# Width (Y): -0.10m to +0.10m (20 cm)
# Height (Z): -0.10m to +0.10m (20 cm)
# Faces +X and -X towards the rover aisles

v  0.001 -0.10 -0.10
v  0.001  0.10 -0.10
v  0.001  0.10  0.10
v  0.001 -0.10  0.10
v -0.001  0.10 -0.10
v -0.001 -0.10 -0.10
v -0.001 -0.10  0.10
v -0.001  0.10  0.10

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  1.0 0.0 0.0
vn -1.0 0.0 0.0

# Front face (+X)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Back face (-X)
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
