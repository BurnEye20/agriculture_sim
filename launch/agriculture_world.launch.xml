<launch>
    <let name="world_path" value="$(find-pkg-share agriculture_sim)/worlds/agriculture_world.sdf"/>
    <let name="urdf_path" value="$(find-pkg-share agriculture_sim)/urdf/agri_rover.urdf"/>
    <let name="bridge_config_path" value="$(find-pkg-share agriculture_sim)/config/agriculture_bridge.yaml"/>
    <let name="rviz_config_path" value="$(find-pkg-share agriculture_sim)/rviz/agriculture_config.rviz"/>
    <let name="yolo_model_path" value="/home/burneye228/ros2_ws/src/agriculture_sim/Final_Fruit_Dataset_YOLOv11/runs/detect/train4/weights/best.pt"/>

    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share agriculture_sim)/models:$(env GZ_SIM_RESOURCE_PATH '')"/>

    <!-- 1. Robot State Publisher (publishes /robot_description and rover TF tree) -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'cat $(var urdf_path)')"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- 2. Gazebo Sim with Strawberry Rows + Agricultural Rover -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -r" />
    </include>

    <!-- 3. ROS 2 <-> Gazebo Bridge (TF, JointStates, Odom, CmdVel, Left & Right Cameras) -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var bridge_config_path)" />
    </node>

    <!-- 4. YOLOv11 Strawberry Disease Detector for Left & Right Rover Cameras -->
    <node pkg="agriculture_sim" exec="yolo_strawberry_detector.py" name="yolo_strawberry_detector" output="screen">
        <param name="model_path" value="$(var yolo_model_path)"/>
        <param name="conf_threshold" value="0.25"/>
    </node>

    <!-- 5. RViz2 with RobotModel, TF, and Left/Right YOLOv11 Detection Feeds -->
    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>
</launch>
