<launch>
    <let name="world_path" value="$(find-pkg-share agriculture_sim)/worlds/agriculture_world.sdf"/>
    <let name="urdf_path" value="$(find-pkg-share agriculture_sim)/urdf/agri_rover.urdf"/>
    <let name="bridge_config_path" value="$(find-pkg-share agriculture_sim)/config/agriculture_bridge.yaml"/>
    <let name="ekf_config_path" value="$(find-pkg-share agriculture_sim)/config/ekf.yaml"/>
    <let name="nav2_params_path" value="$(find-pkg-share agriculture_sim)/config/nav2_params.yaml"/>
    <let name="map_yaml_path" value="$(find-pkg-share agriculture_sim)/maps/farming_rows_map.yaml"/>
    <let name="costmap_yaml_path" value="$(find-pkg-share agriculture_sim)/maps/farming_rows_costmap.yaml"/>
    <let name="rviz_config_path" value="$(find-pkg-share agriculture_sim)/rviz/agriculture_config.rviz"/>
    <let name="yolo_model_path" value="/home/burneye228/ros2_ws/src/agriculture_sim/Final_Fruit_Dataset_YOLOv11/runs/detect/train4/weights/best.pt"/>

    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share agriculture_sim)/models:$(env GZ_SIM_RESOURCE_PATH '')"/>

    <!-- 1. Robot State Publisher (publishes /robot_description and static rover TF tree) -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'cat $(var urdf_path)')"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- 2. Gazebo Sim with Strawberry Rows + Ground ArUco Codes + Agricultural Rover -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -r" />
    </include>

    <!-- 3. ROS 2 <-> Gazebo Bridge (Clock, IMU, Wheel Odom, TF, CmdVel, Cameras) -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var bridge_config_path)" />
        <param name="use_sim_time" value="true" />
    </node>

    <!-- 4. Standard robot_localization EKF Node (world_frame: map, fuses wheel_odom + /rover/imu + /aruco_pose) -->
    <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen">
        <param from="$(var ekf_config_path)"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- 5. Compact ArUco Marker Localizer Node (detects markers, publishes /aruco_pose & RViz tilted camera feed) -->
    <node pkg="agriculture_sim" exec="aruco_localizer_node.py" name="aruco_localizer_node" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- 6. Standard Nav2 Stack (map_server, planner_server, controller_server, behavior_server, bt_navigator, waypoint_follower) -->
    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
        <param name="yaml_filename" value="$(var map_yaml_path)"/>
        <param name="topic_name" value="/map"/>
        <param name="frame_id" value="map"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="nav2_map_server" exec="map_server" name="costmap_server" output="screen">
        <param name="yaml_filename" value="$(var costmap_yaml_path)"/>
        <param name="topic_name" value="/costmap"/>
        <param name="frame_id" value="map"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="nav2_controller" exec="controller_server" name="controller_server" output="screen">
        <param from="$(var nav2_params_path)"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen">
        <param from="$(var nav2_params_path)"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server" output="screen">
        <param from="$(var nav2_params_path)"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator" output="screen">
        <param from="$(var nav2_params_path)"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="nav2_waypoint_follower" exec="waypoint_follower" name="waypoint_follower" output="screen">
        <param from="$(var nav2_params_path)"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_nav2" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="autostart" value="true"/>
        <param name="node_names" value="['map_server', 'costmap_server', 'planner_server', 'controller_server', 'behavior_server', 'bt_navigator', 'waypoint_follower']"/>
    </node>

    <!-- 7. Nav2 Multi-Row Inspection Mission Client -->
    <node pkg="agriculture_sim" exec="nav2_row_mission.py" name="nav2_row_mission" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- 8. YOLOv11 Strawberry Disease Detector for Left & Right Rover Cameras -->
    <node pkg="agriculture_sim" exec="yolo_strawberry_detector.py" name="yolo_strawberry_detector" output="screen">
        <param name="model_path" value="$(var yolo_model_path)"/>
        <param name="conf_threshold" value="0.25"/>
    </node>

    <!-- 9. RViz2 Visualization -->
    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>
</launch>
