<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="agriculture_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.65 0.68 0.70 1</ambient>
      <background>0.53 0.75 0.92 1</background>
      <sky>
        <time>10.5</time>
        <clouds>
          <speed>1.5</speed>
          <humidity>0.35</humidity>
          <mean_size>0.5</mean_size>
        </clouds>
      </sky>
      <shadows>true</shadows>
    </scene>

    <!-- Primary Warm Sunlight -->
    <light name="sun" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.15</intensity>
      <direction>-0.45 0.20 -0.87</direction>
      <diffuse>0.98 0.96 0.90 1</diffuse>
      <specular>0.35 0.35 0.30 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Greenhouse Diffused Fill Light (illuminates opposite row faces evenly) -->
    <light name="greenhouse_fill_light" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>0.55</intensity>
      <direction>0.45 -0.15 -0.88</direction>
      <diffuse>0.90 0.94 0.98 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
    </light>

    <!-- Agricultural Field Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
        </collision>
        <visual name="field_ground_visual">
          <pose>0 15 0 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>file:///home/burneye228/ros2_ws/src/agriculture_sim/models/farming_rows/meshes/field_ground.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.80 0.85 0.80 1</ambient>
            <diffuse>0.95 0.98 0.92 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <pbr>
              <metal>
                <albedo_map>file:///home/burneye228/ros2_ws/src/agriculture_sim/models/farming_rows/meshes/textures/field_grass_soil.png</albedo_map>
                <roughness>0.92</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4 Rows of Vertical Strawberry Systems + Foliage + Greenhouse Frame -->
    <include>
      <uri>file:///home/burneye228/ros2_ws/src/agriculture_sim/models/farming_rows</uri>
      <name>farming_rows</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Agricultural Inspection Rover between Row 2 and Row 3 -->
    <include>
      <uri>file:///home/burneye228/ros2_ws/src/agriculture_sim/models/agri_rover</uri>
      <name>agri_rover</name>
      <pose>1.40 -1.20 0.0 0 0 1.5707963</pose>
    </include>
  </world>
</sdf>
